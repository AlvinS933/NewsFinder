# Copy this file to .env and fill in your real keys:
#     cp .env.example .env
#
# .env is git-ignored. This file (.env.example) IS committed, so it must
# never contain real values — it only documents which variables are needed.

# https://newsapi.org/account
NEWSAPI_KEY=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional — where the Flask server writes articles
JSON_SERVER_URL=http://localhost:8000/blogs
